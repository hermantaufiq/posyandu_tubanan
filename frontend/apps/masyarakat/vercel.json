{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://parabola-feminism-elective.ngrok-free.dev/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
